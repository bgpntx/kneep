# Last.fm Integration (optional)
# Get your API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_SECRET=your_lastfm_secret_here

# AI Playlist Feature
# Last.fm username for fetching listening history (LASTFM_API_KEY is reused from above)
LASTFM_USERNAME=your_lastfm_username
# Anthropic API key for AI playlist generation
ANTHROPIC_API_KEY=your_anthropic_api_key
